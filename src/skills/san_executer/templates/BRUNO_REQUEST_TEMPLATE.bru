meta {
  name: [NOM_DE_L_ACTION]
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/[ressource]
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  Idempotency-Key: {{testIdempotencyKey}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "champ_requis": "valeur_valide"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
  res.responseTime: lte 100
}
